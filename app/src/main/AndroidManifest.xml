<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        АРХИТЕКТУРНЫЙ ИНВАРИАНТ: у приложения нет разрешения на доступ в сеть.
        Без него обычный сетевой доступ приложения через Android API должен быть
        ограничен системой. Это важная защита, но не доказательство отсутствия
        любого возможного сетевого поведения. Не добавляй сетевые permissions.

        Строка с tools:node="remove" ниже нужна, потому что манифесты
        библиотек сливаются с этим: любая зависимость могла бы молча
        добавить INTERNET. С remove слитый манифест его не содержит;
        CI проверяет и исходный, и слитый манифест
        (.github/scripts/check_network_invariant.py).
    -->

    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:name=".SkhoronVaultApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.SkhoronVault"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:process=":vault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".autofill.SkhoronAutofillService"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE"
            android:process=":vault"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />
        </service>

    </application>
</manifest>